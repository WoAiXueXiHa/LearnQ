# 复制为 .env（被 Git 忽略）后按注释填写。不要在本文件写入真实密钥。
# fake 模式不调用外部模型；真实调用前把 AI_MODE 改成 real，并补齐下面各项。
AI_MODE=fake
# 预算单位为百万分之一元；默认 0 阻止真实调用。每次调用预留额不是账单费用。
AI_DAILY_BUDGET_MICROCNY=0
AI_CALL_RESERVE_MICROCNY=0
HTTP_ADDR=127.0.0.1:8080
MYSQL_DSN=learnq:learnq@tcp(127.0.0.1:3306)/learnq?parseTime=true&charset=utf8mb4&multiStatements=true&timeout=5s&readTimeout=10s&writeTimeout=10s
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
QDRANT_URL=http://127.0.0.1:6333

# 对话模型：DeepSeek。密钥留空，real 模式下缺项会在启动时报出变量名。
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_API_KEY=
AI_CHAT_MODEL=deepseek-flash

# Embedding：Cloudflare Workers AI，1024 维。把 URL 里的 REPLACE_WITH_CF_ACCOUNT_ID 换成 Account ID。
AI_EMBEDDING_BASE_URL=https://api.cloudflare.com/client/v4/accounts/REPLACE_WITH_CF_ACCOUNT_ID/ai/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_DIM=1024
# 新 Markdown 用结构切块；回退仅影响后续重建，历史版本保持不变。
DOCUMENT_CHUNK_VERSION=markdown-block-800-v1

# 视觉：DeepSeek 的 OpenAI 兼容多模态接口，只有 Worker 使用。
AI_VISION_PROVIDER=openai
AI_VISION_BASE_URL=https://api.deepseek.com
AI_VISION_API_KEY=
AI_VISION_MODEL=deepseek-flash
AI_VISION_CONTEXT_LENGTH=8192

TASK_TIMEOUT=45s
LEASE_DURATION=60s
REPORT_DIR=data/reports
IMAGE_DIR=data/images
ARTICLE_MAX_IMAGES=32
AUTHORITY_SNAPSHOT_TTL=720h
LEARNQ_HTTP_PORT=8080

# 仅 scripts/eval-redis-evidence.py 使用，Go 服务不读；与上面的 Cloudflare 凭据相同。
CF_ACCOUNT_ID=
CF_API_TOKEN=
